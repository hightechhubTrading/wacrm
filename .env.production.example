# Template for .env.production, the secrets file docker-compose.yml reads
# via `docker compose --env-file .env.production up -d --build`. Copy this
# file, fill in real values, save as .env.production (gitignored — never
# commit that one). See .env.local.example for the fuller explanation of
# each variable; kept brief here since this is deploy-time, not dev-time.

# ============================================================
# REQUIRED — the container won't serve correctly without these.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS — used by the webhook, automation engine, flows engine,
# and the pipeline stage-move route's WAHA notification dispatch.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 64 hex chars = 32 bytes, AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every credential encrypted under the previous key
# (WhatsApp access token, AI provider key, WAHA API key) — they'd all need
# re-entering in Settings.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta for Developers → App Settings → Basic. Verifies the HMAC-SHA256
# signature on every inbound webhook POST — required, the webhook rejects
# every request without it.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================

# Canonical public URL of this deployment — should match the Traefik
# Host() rule in docker-compose.yml. Used for invite links, sitemap, OG
# images.
NEXT_PUBLIC_SITE_URL=https://hightechhub.example.com

# ============================================================
# OPTIONAL — only needed if the corresponding service is enabled.
# ============================================================

# Only if you uncomment the `waha` service in docker-compose.yml (Settings
# → Group notifications feature). WAHA_API_KEY is whatever key you choose
# to protect that container's API; paste the same value into Settings →
# Group notifications afterward, along with the container's reachable URL.
# WAHA_API_KEY=
# WAHA_HOST=waha.example.com
