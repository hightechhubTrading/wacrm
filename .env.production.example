# Template for .env.production, the secrets file docker-compose.yml reads
# via `docker compose --env-file .env.production up -d --build`. Copy this
# file, fill in real values, save as .env.production (gitignored — never
# commit that one). See .env.local.example for the fuller explanation of
# each variable; kept brief here since this is deploy-time, not dev-time.

# ============================================================
# REQUIRED — the container won't serve correctly without these.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS — used by the webhook, automation engine, and flows engine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 64 hex chars = 32 bytes, AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every credential encrypted under the previous key
# (WhatsApp access token, AI provider key) — they'd all need
# re-entering in Settings.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta for Developers → App Settings → Basic. Verifies the HMAC-SHA256
# signature on every inbound webhook POST — required, the webhook rejects
# every request without it.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================

# Canonical public URL of this deployment — should match the Traefik
# Host() rule in docker-compose.yml. Used for invite links, sitemap, OG
# images.
NEXT_PUBLIC_SITE_URL=https://hightechhub.example.com

# ============================================================
# OPTIONAL — only needed if the corresponding service is enabled.
# ============================================================

# Click-to-WhatsApp lead quality -> Meta Conversions API (migration 065).
# Leave META_CAPI_ENABLED=false until a test event shows up in Events
# Manager. Token: System User with whatsapp_business_management +
# whatsapp_business_manage_events. Dataset: POST /{WABA_ID}/dataset.
# META_CAPI_ENABLED=false
# META_DATASET_ID=
# META_WABA_ID=
# META_CAPI_ACCESS_TOKEN=
# GRAPH_API_VERSION=v24.0
# META_TEST_EVENT_CODE=

# TypeSafe sales checks (optional, server-side only). With a key, defaults
# to enforce: intent guidance, human handoff, reply/action verification.
# No key defaults to off. Enforce without a key requires human review.
# Create a key at https://console.typesafe.ai/keys; see docs/jev-sales.md.
# off = no calls; shadow = observe only; enforce = apply the checks.
# TYPESAFE_MODE=enforce
# TYPESAFE_TIMEOUT_MS=5000
# TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=

# Observe review-derived Jev routing/output checks before enabling enforcement.
TYPESAFE_SALES_V2_MODE=shadow
# Locally extract supported inbound document text; unsupported files need human review.
AI_DOCUMENT_PARSING_ENABLED=true

# Internal sales preparation: shadow previews; enforce writes approved tags/empty fields.
# Account opt-in and approved tag rules live in AI agents > Setup. Requires migration 072.
TYPESAFE_SALES_ASSISTANCE_MODE=shadow
